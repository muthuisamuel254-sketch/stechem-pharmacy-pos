# ===== Meta WhatsApp Cloud API (automatic OTP) =====
# From https://developers.facebook.com/ → your app → WhatsApp → API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved template name (Authentication or Utility category)
WHATSAPP_OTP_TEMPLATE=stechem_login_otp
WHATSAPP_TEMPLATE_LANG=en
# Set to 1 if your template has a Copy Code / URL button that needs the OTP
# WHATSAPP_TEMPLATE_COPY_CODE=1
# WHATSAPP_GRAPH_VERSION=v21.0

# ===== Optional: Africa's Talking SMS fallback =====
# AT_USERNAME=
# AT_API_KEY=
# AT_SENDER_ID=STECHEM

# ===== M-Pesa Daraja (STK Push) =====
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_PASSKEY=
# MPESA_ENV=sandbox
# MPESA_CALLBACK_URL=https://your-domain.vercel.app/api/mpesa/callback
# NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# ===== Multi-device shared backend (Upstash Redis) =====
# https://console.upstash.com → Create database → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
